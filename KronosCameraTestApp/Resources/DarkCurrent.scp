
ASSIGN Exposure exp1 = ( 
    .exposure_interval     = 27000, // 11.000 sec
    .exposure_ndros     = 1,
    .exposure_region.xo     = 0,
    .exposure_region.yo     = 0,
    .exposure_region.dx     = 0,
    .exposure_region.dy     = 0,
    .exposure_fpn     = 0,
    .full_frame_enabled     = False,
    .dark_frame_enabled     = False,
    .use_default_configuration     = False,
    .led1_enabled     = True,
    .led2_enabled     = False,
    .led3_enabled     = True,
    .led_ontime     = 10000,
    .led_offtime     = 100,
    .led_flashes     = 10,
    .shutter_enabled     = False,
    .autobias_fpn_enabled     = False,
    .num_subarrays  = 1,
    .sa_list[0].name   = Subarray1,
    .sa_list[0].subarray_region.xo   = 1000,
    .sa_list[0].subarray_region.yo   = 1000,
    .sa_list[0].subarray_region.dx   = 100,
    .sa_list[0].subarray_region.dy   = 100,
    .sa_list[0].subarray_fpn = 0,
    .sa_list[0].read_enabled   = True,
    .sa_list[0].read_interval   = 1000, // 1000 ms, 1.000 sec
    .sa_list[0].subinject_enabled   = False,
    .sa_list[0].subinject_interval   = 0,
    .sa_list[0].postread_enabled   = False,
    .sa_list[0].postread_ndros   = 1,
    .sa_list[0].threshold_enabled   = False,
    .sa_list[0].threshold_percent   = 75,
    .sa_list[0].threshold_region.xo   = 0,
    .sa_list[0].threshold_region.yo   = 0,
    .sa_list[0].threshold_region.dx   = 0,
    .sa_list[0].threshold_region.dy   = 0,
    .sa_list[0].time_resolved_enabled   = False,
    .sa_list[0].adaptive_enabled   = False
 )
 
GI( 5 )
DELAY( 1 ) 
EXPOSE( exp1 )
  
START                   // CAMERA start sequence
