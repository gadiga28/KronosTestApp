        private void UpdateExposureDataModelFromView()
        {
            try
            {
                linearityPresenter.ExposureDataModel = new ExposureDataModel();

                linearityPresenter.ExposureDataModel.ExposureID = Convert.ToInt32(ultraTextEditorExposureID.Value);
                linearityPresenter.ExposureDataModel.TestDataID = "LIT";
                linearityPresenter.ExposureDataModel.UserModified = Environment.UserName;
                linearityPresenter.ExposureDataModel.GlobalInjectDelay = Convert.ToInt32(numericEditDelay.Value);
                linearityPresenter.ExposureDataModel.GlobalInject = Convert.ToInt32(numericEditGlobalInject.Value);

                //Exposure         
                linearityPresenter.ExposureDataModel.ExposureName = ultraTextEditorExposureName.Text.ToString();
                linearityPresenter.ExposureDataModel.ExposureInterval = Convert.ToInt32(numericEditExposureInterval.Value);
                linearityPresenter.ExposureDataModel.ExposureNDROS = Convert.ToInt32(numericEditNDRO.Value);
                linearityPresenter.ExposureDataModel.ExposureRegionXo = Convert.ToInt32(numericEditExposureStartX.Value);
                linearityPresenter.ExposureDataModel.ExposureRegiondX = Convert.ToInt32(numericEditExposureWidth.Value);
                linearityPresenter.ExposureDataModel.ExposureRegionYo = Convert.ToInt32(numericEditExposureStartY.Value);
                linearityPresenter.ExposureDataModel.ExposureRegiondY = Convert.ToInt32(numericEditExposureHeight.Value);
                linearityPresenter.ExposureDataModel.LED1Enabled = ultraCheckEditorLED1.Checked;
                linearityPresenter.ExposureDataModel.LED2Enabled = ultraCheckEditorLED2.Checked;
                linearityPresenter.ExposureDataModel.LED3Enabled = ultraCheckEditorLED3.Checked;
                linearityPresenter.ExposureDataModel.ShutterEnabled = ultraCheckEditorShutterEnabled.Checked;
                linearityPresenter.ExposureDataModel.LEDOnTime = Convert.ToInt32(numericEditLEDOn.Value);
                linearityPresenter.ExposureDataModel.LEDOffTime = Convert.ToInt32(numericEditLEDOff.Value);
                linearityPresenter.ExposureDataModel.LEDFlashes = Convert.ToInt32(numericEditFlash.Value);
                linearityPresenter.ExposureDataModel.NumberOfSubarrays = Convert.ToInt32(ultraTextEditorNumberOfSubarrays.Value);

                if (ultraRadioButtonFPNNone.Checked == true)
                {
                    linearityPresenter.ExposureDataModel.ExposureFPN = 0;
                }
                else if (ultraRadioButtonFPNRunTime.Checked == true)
                {
                    linearityPresenter.ExposureDataModel.ExposureFPN = 1;
                }
                else if (ultraRadioButtonFPNStored.Checked == true)
                {
                    linearityPresenter.ExposureDataModel.ExposureFPN = 3;
                }

                linearityPresenter.ExposureDataModel.FullFrameEnabled = ultraCheckEditorExposedFrame.Checked;
                linearityPresenter.ExposureDataModel.DarkFrameEnabled = ultraCheckEditorDarkFrame.Checked;

            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
