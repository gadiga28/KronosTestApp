        public LinearityTestForm()
        {
            InitializeComponent();
        }
        public LinearityTestForm(LinearityPresenter linearityPresenter, string UserMode, bool enggLoginStatus,
            CIDInterface cidInterface, Infragistics.Win.UltraWinStatusBar.UltraStatusBar statusBar)
        {
            try
            {
                InitializeComponent();
                currentSubarrayRecord = 0;
                currentRecord = 0;
                this.linearityPresenter = linearityPresenter;
                this.userMode = UserMode;
                this.engineeringLoginStatus = enggLoginStatus;
                this.cidInterface = cidInterface;
                this.statusBar = statusBar;
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        private async void LinearityTestForm_Load(object sender, EventArgs e)
        {
            try
            {
                if (Properties.Settings.Default.selectedGraphPreferencesList != null)
                {
                    if (Properties.Settings.Default.selectedGraphPreferencesList.Contains("LIT"))
                    {
                        this.linearityWaveformGraph.PlotAreaColor = Properties.Settings.Default.colorOfPlotBackground;
                        this.linearityTestWaveformPlot.LineWidth = Properties.Settings.Default.lineWidthOfPlot;
                        this.meanWaveformPlot.LineWidth = Properties.Settings.Default.lineWidthOfPlot;
                        this.log20WaveformPlot.LineWidth = Properties.Settings.Default.lineWidthOfPlot;

                        this.derivativeWaveformGraph.PlotAreaColor = Properties.Settings.Default.colorOfPlotBackground;
                        this.derivativeWaveformPlot.LineWidth = Properties.Settings.Default.lineWidthOfPlot;
                        this.waveformPlot2.LineWidth = Properties.Settings.Default.lineWidthOfPlot;
                    }
                }

                currentRecord = 0;
                currentSubarrayRecord = 0;
                if (linearityPresenter.ExposureDataList.Count == 0)
                {
                    Cursor.Current = Cursors.WaitCursor;
                    await linearityPresenter.GetLinearityData(cidInterface);
                    //numericEditNumOfExposures.Maximum = linearityPresenter.ExposureDataList.Count;
                    //numericEditNumOfExposures.Value = linearityPresenter.ExposureDataList.Count;
                    //AutoCompleteExposureSubarray();
                    Cursor.Current = Cursors.Arrow;
                    UpdateExposureView(0);
                }
               
                    numericEditNumOfExposures.Maximum = linearityPresenter.ExposureDataList.Count;
                    numericEditNumOfExposures.Value = linearityPresenter.ExposureDataList.Count;
                    AutoCompleteExposureSubarray();
                    UpdateExposureView(0);

                    if (userMode == "Admin" && engineeringLoginStatus)
                {

                    AddExposure.Enabled = true;
                    RemoveExposure.Enabled = true;
                    UpdateExposure.Enabled = true;
                    AddSubarray.Enabled = true;
                    RemoveSubarray.Enabled = true;
                    UpdateSubarray.Enabled = true;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error Loading Linearity Test Form", "Loading Form", MessageBoxButtons.OK);
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        private async void buttonLinearityRun_Click(object sender, EventArgs e)
        {
            try
            {
                 if (cidInterface.IsConnected())
                {
                    if (Convert.ToInt32(numericEditNumOfExposures.Value) <= 0 )
                    {
                        MessageBox.Show("Exposure count should be greater than 0", "Invalid exposure count", MessageBoxButtons.OK,
                            MessageBoxIcon.Error);
                        return;
                    }
                    ledPassFail.Value = false;
                cts = new CancellationTokenSource();
                TestAppHelper.currentRunningTest = "Linearity";
                //((KronosTestAppMainForm)this.MdiParent).cidDataList.Clear();
                statusBar.Panels["TestProgress"].ProgressBarInfo.Value = 1;
                linearityTestStatus = true;
                statusBar.Panels["MarqueeStatus"].Text = "Linearity Test Processing....";
                statusBar.Panels["MarqueeStatus"].MarqueeInfo.Start();
                //((KronosTestAppMainForm)this.MdiParent).ExpCount = Convert.ToInt32(numericEditNumOfExposures.Value);

                buttonLinearityAbort.Enabled = true;

                linearityTestWaveformPlot.ClearData();
                derivativeWaveformPlot.ClearData();

                //linearityPresenter.CIDDataList.Clear();
               // UpdateModelFromView();
                //ApplySettings();

                UpdateExposureDataModelFromView();
                UpdateSubarrayDataModelFromView();

                //Run Linearity Test
                await RunLinearityTest(cts.Token);

                //Plot data
                await PlotLinearityData(cts);

                statusBar.Panels["TestProgress"].ProgressBarInfo.Value = 100;
                //write test results to DB
                //await linearityPresenter.WriteLinearityTestResultToDB(cts.Token);

                statusBar.Panels["MarqueeStatus"].MarqueeInfo.Stop();
                if (cts.IsCancellationRequested)
                {
                    statusBar.Panels["MarqueeStatus"].Text = "Linearity Test Aborted";
                }
                else
                {
                    statusBar.Panels["MarqueeStatus"].Text = "Linearity Test Completed";
                }
                //this.gainLabel.Text = "Gain : " + gain.ToString("0.00") + " e-/ADU";
                buttonLinearityAbort.Enabled = false;
                linearityTestStatus = false;
                ultraExplorerBar1.Groups[1].Expanded = true;
                }
                 else
                 {
                     log.Error("Firmware not running or camera not connected to host");
                     MessageBox.Show(
                           "Firmware not running or camera not connected to host",
                           "Firmware not found",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information);
                     return;
                 }
            }
            catch (Exception ex)
            {
                //"Internal Error";
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        private async Task RunLinearityTest(CancellationToken ct)
        {
            try
            {
                log.Debug("Run Mean Variance test.");
                await linearityPresenter.runLinearityTest(cidInterface, ct, Convert.ToInt32(numericEditNumOfExposures.Value));
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private async Task PlotLinearityData(CancellationTokenSource ct)
        {
            try
            {
                if (ct.IsCancellationRequested)
                    return;
                else
                {
                    await linearityPresenter.CalculateLinearity(ct.Token);
                    linearityTestWaveformPlot.PlotYAppend(linearityPresenter.ROID);
                    derivativeWaveformPlot.PlotY(linearityPresenter.Deriv);
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private async void buttonLinearityAbort_Click(object sender, EventArgs e)
        {
            try
            {
                if (cts != null)
                {
                    DialogResult result = MessageBox.Show("Are you sure to Abort Linearity Test?",
                           "Abort Linearity Test",
                             MessageBoxButtons.YesNo,
                             MessageBoxIcon.Question);
                    if (result == DialogResult.Yes)
                    {
                        cidInterface.AbortExposure();
                        await ClearLinearityGraphs();
                        linearityTestStatus = false;
                        statusBar.Panels["TestProgress"].ProgressBarInfo.Value = 0;
                        statusBar.Panels["TestProgress"].ProgressBarInfo.ResetFillAppearance();
                        cts.Cancel();
                    }
                    else
                        return;
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        public async Task ClearLinearityGraphs()
        {
            await Task.Run(() =>
            {
                linearityTestWaveformPlot.ClearData();
                derivativeWaveformPlot.ClearData();
            });
        }
