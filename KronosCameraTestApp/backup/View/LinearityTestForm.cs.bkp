        private async void buttonRefresh_Click(object sender, EventArgs e)
        {
            try
            {
                ClearExposure();
                await linearityPresenter.PopulateLinearityData();
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private void ClearExposure()
        {
            try
            {
                ultraTextEditorExposureID.Text = "";
                ultraTextEditorExposureName.Text = "";
                ultraTextEditorNumberOfSubarrays.Text = "";
                numericEditDelay.Value = 0;
                numericEditGlobalInject.Value = 0;

                //ultraGroupBoxExposure.Text = "Exposure:" + "";

                numericEditExposureInterval.Value = 0;
                numericEditNDRO.Value = 0;
                numericEditExposureStartX.Value = 0;
                numericEditExposureWidth.Value = 0;
                numericEditExposureStartY.Value = 0;
                numericEditExposureHeight.Value = 0;


                ultraCheckEditorLED1.Checked = false;
                ultraCheckEditorLED2.Checked = false;
                ultraCheckEditorLED3.Checked = false;
                ultraCheckEditorShutterEnabled.Checked = false;

                numericEditLEDOn.Value = 0;
                numericEditLEDOff.Value = 0;
                numericEditFlash.Value = 0;

                ultraRadioButtonFPNNone.Checked = true;

                ultraCheckEditorExposedFrame.Checked = false;
                ultraCheckEditorDarkFrame.Checked = false;

                ClearSubarray();

            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private void ClearSubarray()
        {
            try
