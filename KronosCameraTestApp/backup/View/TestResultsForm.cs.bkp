        private void UpdateResultsGrid(string str)
        {
            try
            {
                //Application.UseWaitCursor = true;
                UseWaitCursor = true;

                switch (str)
                {
                    case "MeanVariance":
                    case"Mean Variance Test Results":
                        UpdateMeanVarianceResultsGrid();
                        break;
                    case "DarkCurrent":
                    case "Dark Current Test Results":
                        UpdateDarkCurrentResultsGrid();
                        break;
                    case "InjectionPerformance":
                    case "Injection Performance Test Results":
                        UpdateInjectionPerformaceResultsResultsGrid();
                        break;
                    case "ReadNoiseVsNDROs":
                    case "Noise Vs NDROs Test Results":
                        UpdateNoiseVsNDROsResultsGrid();
                        break;
                    case "Photoresponse":
                    case "Photoresponse Test Results":
                        UpdatePhotoresponseResultsGrid();
                        break;
                    case "RedBlue":
                    case "Red&Blue Test Results":
                        UpdateRedBlueResultsGrid();
                        break;
                    case "ShutterDrive":
                    case "ShutterDrive Test Results":
                        UpdateShutterDriveResultsGrid();
                        break;
                    case "OverAllResults":
                    case "Over All Test Results":
                        //Application.UseWaitCursor = true;
                        UseWaitCursor = true;
                        //Cursor.Current = Cursors.WaitCursor;
                        //Application.DoEvents();
                        ultraGrid1.UseWaitCursor = true;
                        ultraGrid1.Text = "Over All Test Results";
                        ultraGrid1.DataSource = OverallModelList;
                        ultraGrid1.UseWaitCursor = false;
                        //Cursor.Current = Cursors.Default;
                        //Application.UseWaitCursor = false;
                        UseWaitCursor = false;
                        break;

                }
                //Application.UseWaitCursor = false;
                UseWaitCursor = false;
            }
            catch (Exception ex)
            {
                //Application.UseWaitCursor = false;
                UseWaitCursor = false;   
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private void ultraGrid1_InitializeLayout(object sender, Infragistics.Win.UltraWinGrid.InitializeLayoutEventArgs e)
        {
            try
            {
                UseWaitCursor = true;
                InitializeGridLayout();
                e.Layout.Override.AllowUpdate = Infragistics.Win.DefaultableBoolean.False;
                UseWaitCursor = false;
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private void InitializeGridLayout()
        {
            try
            {
                //await Task.Run(() =>
                //    {
                Application.UseWaitCursor = true;
                UseWaitCursor = true;
                        ultraGrid1.DisplayLayout.Bands[0].Columns["TestResultImagePath"].Hidden = true;
                        if (ultraGrid1.Rows.Count > 0)
                        {
                            foreach (Infragistics.Win.UltraWinGrid.UltraGridRow row in ultraGrid1.Rows)
                            {
                                if (row.ChildBands != null && row.ChildBands.Count > 0)
                                {
                                    foreach (Infragistics.Win.UltraWinGrid.UltraGridChildBand childband in row.ChildBands)
                                    {
                                        childband.Band.HeaderVisible = true;
                                        if (childband.Rows.Count > 0)
                                        {
                                            foreach (Infragistics.Win.UltraWinGrid.UltraGridCell cell in childband.Rows[0].Cells)
                                            {
                                                if (cell.Column.Key.ToString().Equals("TestResultImagePath"))
                                                {
                                                    cell.Column.Hidden = true;
                                                    if (cell.Value != null && !string.IsNullOrWhiteSpace(cell.Value.ToString()))
                                                    {
                                                        //Bitmap resultImage = new Bitmap(cell.Value.ToString());

                                                        childband.Rows[0].Cells["ResultImage"].Value = cell.Value.Equals(null) ? null : new Bitmap(Settings.Default.AutoTestResultsLocalFilePath + cell.Value.ToString());
                                                    }
                                                }

                                            }
                                        }

                                    }
                                }
                                if( row.Cells.Count > 0)
                                {
                                    foreach (Infragistics.Win.UltraWinGrid.UltraGridCell cell in row.Cells)
                                    {
                                        if (cell.Column.Key.ToString().Equals("TestResultImagePath"))
                                        {
                                            if (cell.Value != null && !string.IsNullOrWhiteSpace(cell.Value.ToString()))
                                            {
                                                //Bitmap resultImage = new Bitmap(cell.Value.ToString());
                                                row.Cells["ResultImage"].Value = cell.Value.Equals(null) ? null : new Bitmap(Settings.Default.AutoTestResultsLocalFilePath + cell.Value.ToString());
                                            }
                                        }
                                    }
                                }                               
                            }
                        }
                        Application.UseWaitCursor = false;
                        UseWaitCursor = false;
                    //});
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
                Application.UseWaitCursor = false;
                UseWaitCursor = false;
            }
        }
        private void ultraGrid1_ClickCell(object sender, Infragistics.Win.UltraWinGrid.ClickCellEventArgs e)
        {
            try
            {               
                foreach (Infragistics.Win.UltraWinGrid.UltraGridCell cell in ultraGrid1.ActiveRow.Cells)
                    {
                        if (cell.Column.Key.ToString().Equals("ResultImage"))
                        {
                            if (cell.Value != null)
                            {                                
                                ultraPictureBox1.Image = (Image)cell.Value;
                            }
                            else
                            {
                                ultraPictureBox1.Image = null;
                            }
                        }
                        else if(cell.Column.Key.ToString().Equals("DateExecuted"))
                        {
                            if (cell.Value != null)
                                printDocumentHeaderTitle = cell.Value.ToString(); 
                        }
                    }            
                              
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }      
