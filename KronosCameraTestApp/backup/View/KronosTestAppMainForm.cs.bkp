        private void ApplyInfraStyle(object sender, ToolEventArgs e)
        {
            try
            {
                if (((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).SelectedIndex != -1)
                {
                    theStyleFile = ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).SelectedItem.ToString();
                    Properties.Settings.Default.InfraStyleName = theStyleFile;
                    stylePath = File.Exists("InfraStyles/" + theStyleFile + ".isl");
                    if (theStyleFile == "Default")
                    {
                        Infragistics.Win.AppStyling.StyleManager.Reset();
                        log.Info("Application Theme/Style Reset to Default");
                    }
                    else
                    {
                        Infragistics.Win.AppStyling.StyleManager.Load(stylePath ? "InfraStyles/" + theStyleFile + ".isl" : assemblyPath + "//" + theStyleFile + ".isl");
                        log.Info("Application Theme/Style Changed");
                    }
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        private async Task LoadInfraStyles()
        {
            try
            {
                await Task.Run(() =>
                    {
                        Invoke(new System.Action(() =>
                        {
                            ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Clear();
                            ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Add("Default", "Default");
                            string[] theFiles = Directory.GetFiles(assemblyPath, "InfraStyles\\*.isl");
                            if (theFiles.Length > 0)
                            {
                                foreach (string theFile in theFiles)
                                {
                                    ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Add(theFile, Path.GetFileNameWithoutExtension(theFile));
                                }
                            }
                            ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).SelectedIndex = 0;
                        }));

                        //((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Clear();
                        //((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Add("Default", "Default");
                        //string[] theFiles = Directory.GetFiles(assemblyPath, "InfraStyles\\*.isl");
                        //if (theFiles.Length > 0)
                        //{
                        //    foreach (string theFile in theFiles)
                        //    {
                        //        ((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).ValueList.ValueListItems.Add(theFile, Path.GetFileNameWithoutExtension(theFile));
                        //    }
                        //}
                        //((ComboBoxTool)ultraToolbarsManager1.Toolbars.ToolbarsManager.Tools["Apply Styles"]).SelectedIndex = 0;
                    });

            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        private void ShowOrActivateForm<T>() where T : Form
        {
            try
            {
                var k = MdiChildren.Where(c => c.GetType() == typeof(T)).FirstOrDefault();
                if (k == null)
                {

                    k = (Form)Activator.CreateInstance(typeof(T));
                    k.MdiParent = this;
                    k.Show();
                }
                else
                {
                    k.Activate();
                    k.BringToFront();
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
        private void ultraExplorerBar1_ItemClick(object sender, Infragistics.Win.UltraWinExplorerBar.ItemEventArgs e)
        {
            try
            {
                cidDataList.Clear();
                cidIntegratedDataList.Clear();
                ResetProgressBar();
                switch (e.Item.Tag.ToString())
                {
                    case "Dashboard":
                        ManualTestDashBoard();
                        break;
                    case "meanvarianceForm":
                        //ECOData eCODetails = new ECOData();
                        //List<ECOData> ecoDataList = new List<ECOData>();

                        //MeanVarianceTestLimitsData MVLimitsData = new MeanVarianceTestLimitsData();
                        //DarkCurrentTestLimitsData darkCurrentTestLimitsData = new DarkCurrentTestLimitsData();
                        //using (var kcc = new KronosCamContext())
                        //{
                        //    ecoDataList = (from eco in kcc.ecoData orderby eco.DefinedDate descending select eco).ToList();
                        //    if (ecoDataList != null && ecoDataList.Count > 0)
                        //    {
                        //        eCODetails = ecoDataList[0];
                        //    }
                        //}

                        ManualMeanVarianceTest();
                        break;
                    case "Linearity":
                        //ManualLinearityTest();
                        break;
                    case "photoresponseForm":
                        ManualPhotoresponseTest();
                        break;
                    case "defectsDarkCurrrentForm":
                        ManualDarkCurrentTest();
                        break;
                    case "readnoiseNDROForm":
                        ManualNoiseVsNDROTest();
                        break;
                    case "injectionPerformanceForm":
                        ManualInjectionPerformanceFormTest();
                        break;
                    case "crossTalkForm":
                        ManualCrossTalkTest();
                        break;
                    case "chargeTransferForm":
                        ManualChargeTransferLossesTest();
                        break;
                    case "shutterDriveRS232Form":
                        //ShowOrActivateForm<ShutterDriveAndRS232TestForm>();
                        ManaualShutterDriveTest();
                        break;
                    case "RedBlueTest":
                        ManualRedBlueTest();
                        break;
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }
