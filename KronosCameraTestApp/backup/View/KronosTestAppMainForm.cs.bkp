        private void OpenDocuments()
        {
            try
            {
                openFileDialog1.Filter = "jpeg (*.jpg)|*.jpg|Bitmap (*.bmp)|*.bmp|Tiff (*.tiff)|*.tiff|XML Files (*.xml)|*.xml";
                openFileDialog1.FilterIndex = 1;
                openFileDialog1.InitialDirectory = Properties.Settings.Default["FilesLocation"].ToString();
                ImageDisplayForm imageDisplayForm = new ImageDisplayForm();
                DialogResult result = openFileDialog1.ShowDialog(this);
                if (result == DialogResult.OK)
                {
                    if (openFileDialog1.FileName.Contains(".jpeg") || openFileDialog1.FileName.Contains(".bmp") || openFileDialog1.FileName.Contains(".tiff"))
                    {
                        imageDisplayForm.webBrowser1.Visible = false;
                        imageDisplayForm.ultraPictureBox1.Visible = true;
                        imageDisplayForm.ultraPictureBox1.Image = new Bitmap(openFileDialog1.FileName);
                    }
                    else
                    {
                        imageDisplayForm.webBrowser1.Visible = true;
                        imageDisplayForm.ultraPictureBox1.Visible = false;

                        using (var myStream = openFileDialog1.OpenFile())
                        {
                            try
                            {
                                imageDisplayForm.webBrowser1.Navigate(openFileDialog1.FileName);

                            }
                            catch (XmlException ex)
                            {
                                MessageBox.Show("The XML could not be read. " + ex);
                            }

                        }
                    }
                    imageDisplayForm.Text = openFileDialog1.FileName;
                    imageDisplayForm.Show(this);
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        public void SaveImage(string ImageType)
        {
            try
            {
                if (this.ActiveMdiChild != null)
                {
                    Form activeChild = this.ActiveMdiChild;
                    string datetimestamp = DateTime.Now.ToString("MMddyyyy_hhmmss");
                    string path = System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location);
                    Image img = null;
                    Image img1 = null;
                    Image img2 = null;                    
                    int outputImageWidth = 0;
                    int outputImageHeight = 0;
                    Bitmap outputImage = null;
                    saveFileDialog1.InitialDirectory = Properties.Settings.Default["FilesLocation"].ToString();
                    if (ImageType == "Bitmap")
                    {
                        saveFileDialog1.Title = "Save As Bitmap";
                        saveFileDialog1.DefaultExt = "*.";
                        saveFileDialog1.Filter = "Windows Bitmap|*.bmp";
                    }
                    else if (ImageType == "JPEG")
                    {
                        saveFileDialog1.Title = "Save As Jpeg";
                        saveFileDialog1.DefaultExt = "*.";
                        saveFileDialog1.Filter = "Jpeg|*.jpeg";
                    }
                    else if (ImageType == "PNG")
                    {
                        saveFileDialog1.Title = "Save As PNG";
                        saveFileDialog1.DefaultExt = "*.";
                        saveFileDialog1.Filter = "Png|*.png";
                    }
                    else
                    {
                        saveFileDialog1.Title = "Save As Tiff";
                        saveFileDialog1.DefaultExt = "*.";
                        saveFileDialog1.Filter = "Tiff|*.tiff";
                    }

                    if (activeChild.Name == "MeanVarianceTestForm")
                    {
                        img = meanVarianceTestForm.meanVarianceScatterGraph.ToImage();
                        img1 = meanVarianceTestForm.meanVarianceWaveformGraph.ToImage();
                        saveFileDialog1.FileName = "MeanVariance_" + datetimestamp;
                    }
                    else if (activeChild.Name == "ShutterDriveTestForm")
                    {
                        img = shutterDriveTestForm.shutterWaveformGraph.ToImage();
                        //img1 = shutterDriveTestForm.shutterWaveformGraph2.ToImage();
                        saveFileDialog1.FileName = "ShutterDrive_" + datetimestamp;
                    }
                    else if (activeChild.Name == "DarkCurrentTestForm")
                    {
                        img = darkCurrentTestForm.darkCurrentWaveformGraph.ToImage();
                        saveFileDialog1.FileName = "DarkCurrent_" + datetimestamp;
                    }
                    else if (activeChild.Name == "NoiseVsNDROTestForm")
                    {
                        img = noiseVsNDROTestForm.readNoiseScatterGraph.ToImage();
                        saveFileDialog1.FileName = "NoiseVsNDRO_" + datetimestamp;
                    }                   
                    else if (activeChild.Name == "InjectionPerformanceTestForm")
                    {
                        img = injectionPerformanceTestForm.signalLevelAfterInjectionWaveformGraph.ToImage();
                        img1 = injectionPerformanceTestForm.signalLevelBeforeInjectionWaveformGraph.ToImage();

                        saveFileDialog1.FileName = "InjectionPeformance_" + datetimestamp;
