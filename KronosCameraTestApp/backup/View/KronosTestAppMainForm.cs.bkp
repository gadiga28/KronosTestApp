        private void button1_Click(object sender, EventArgs e)
        {
            try
            {

                log.Error("Start1");
                string filetimestamp = DateTime.Now.ToString("MM_dd_yyyy_HH_mm");
                DirectorySecurity securityRules = new DirectorySecurity();

                log.Error("Start2.1");
                FileSystemAccessRule fas = new FileSystemAccessRule(Environment.UserDomainName + "\\" + "USLIV-EVERYONE", FileSystemRights.FullControl | FileSystemRights.CreateDirectories |
                    FileSystemRights.CreateFiles | FileSystemRights.WriteData | FileSystemRights.Write | FileSystemRights.Modify, AccessControlType.Allow);
                log.Error("Start2.2");
                if (securityRules != null)
                {
                    log.Error("Start2.3");
                    if (fas != null)
                    {
                        log.Error("Start2.4");
                        if (securityRules != null)
                            securityRules.AddAccessRule(fas);
                    }

                    else
                    {
                        log.Error("Start2.5");
                    }

                }
                else
                {
                    log.Error("Start2.6");
                }

                log.Error("Start2.7");
                log.Error(securityRules.ToString());
                //return securityRules;


            }
            catch (NullReferenceException ex)
            {
                if (ex.InnerException != null)
                    log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex.InnerException);
                log.Error(ex.Message);
                log.Error(ex.HResult.ToString());
                //return null;
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
                //return null;
            }

        }

