        private async void updateExposureAndLimitModelsFromDB()
        {
            try
            {
                //meanvariance
                await meanVariancePresenter.PopulateMVEntity();
                await meanVariancePresenter.GetMVLimits();

                //DarkCurrent
                await darkCurrentPresenter.PopulateDarkCurrentEntity();
                await darkCurrentPresenter.GetDefectsLimits();
                await darkCurrentPresenter.GetDarkCurrentLimits();

                //InjectioPerformace
                await injectionPerformancePresenter.PopulateInjectionPerformanceEntity();
                await injectionPerformancePresenter.GetLimits();


                //Photoresponse
                await photoresponsePresenter.PopulatePhotoresponseEntity();
                await photoresponsePresenter.GetLimits();

                //RedBlue
                await redBluePresenter.PopulateRedBlueEntity();
                
                //NoiseVsNDROs
                await noiseVsNDROPresenter.PopulateNoiseNDROEntity();
                await noiseVsNDROPresenter.GetLimits();

                //shutterDrive
                await shutterDrivePresenter.PopulateShutterDriveEntity();

                //other limits data

                await defectsTestLimitsPresenter.GetDefectsLimits();
                await injectionEfficiencyTestLimitsPresenter.GetInjectionEfficiencyLimits();
                await nDROReadDriftTestLimitsPresenter.GetNdroReadDriftLimits();
                await segmentInjectLimitsPresenter.GetSegmentInjectLimits();

            }
            catch(Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
    }
