        private void ReceivedCameraExposureComplete(int exposureId)
        {
            try
            {
                if (this.InvokeRequired)
                {
                    this.BeginInvoke((MethodInvoker)delegate()
                    {
                        this.ReceivedCameraExposureComplete(exposureId);

                    });
                    return;
                }
                if (!AutoTestStatus || !AutoPreTestStatus)
                {
                    CID821_Data dataItem = new CID821_Data();

                    dataItem.videoIntegratedDataList = new Int32[xArraySize, yArraySize];
                    for (int cidDataListIndex = integratedModeStartIndex; cidDataListIndex < cidDataList.Count; cidDataListIndex++)
                    {
                        string imageType = cidDataList[cidDataListIndex].imageType.ToString();

                        // Populate the new dataItem for the integrated data list
                        dataItem.column = cidDataList[cidDataListIndex].column;
                        dataItem.row = cidDataList[cidDataListIndex].row;
                        dataItem.dc = cidDataList[cidDataListIndex].dc;
                        dataItem.dr = cidDataList[cidDataListIndex].dr;
                        dataItem.subarrayNumber = cidDataList[cidDataListIndex].subarrayNumber;
                        dataItem.subarrayName = cidDataList[cidDataListIndex].subarrayName;
                        dataItem.subarrayTimeStamp = cidDataList[cidDataListIndex].subarrayTimeStamp;
                        dataItem.exposureNumber = cidDataList[cidDataListIndex].exposureNumber;
                        dataItem.subarraySequenceNumber = integratedSequenceNumber;
                        dataItem.exposureNumber = (int)exposureId;

                    }
                    // Set the start index to start the next Integrated Data Mode exposure from the end of the current data list
                    //          integratedModeStartIndex = cidDataList.Count;
                    integratedModeStartIndex = 0;

                    integratedSequenceNumber++;

                    // initialize min & max
                    minSignal = 650000;
                    maxSignal = 0;
                    for (int x = 0; x < xArraySize; x++)
                    {
                        for (int y = 0; y < yArraySize; y++)
                        {
                            if (dataItem.videoIntegratedDataList[x, y] < minSignal)
                                minSignal = dataItem.videoIntegratedDataList[x, y];

                            if (dataItem.videoIntegratedDataList[x, y] > maxSignal)
                                maxSignal = dataItem.videoIntegratedDataList[x, y];
                        }
                    }

                    //Range range;
                    //if (minSignal == maxSignal + (maxSignal * 0.1))
                    //    range = new Range(minSignal, minSignal + 1);
                    //else
                    //    range = new Range(minSignal, maxSignal + (maxSignal * 0.1));

                    //zPatternCorrectedData = TestAppHelper.ConvertVideoDataToDouble2D(dataItem.videoIntegratedDataList);

                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }

        }
        public async void AutoConnectCamera()
        {
            try
            {

                ultraStatusBar1.Panels["CameraStatus"].Text = "Connecting to Camera....";
                if (!cidInterface.IsConnected())
                {
                    var task = new Task(delegate()
                    {
                        ultraStatusBar1.Panels["CameraStatus"].Text = "Connecting to Camera....";

                        //Ping pingCameraIP = new Ping();

                        //PingReply reply = pingCameraIP.Send("192.168.1.2");
                        //if(reply.Status==IPStatus.Success)
                        //{

                        //}
                        cameraConnected = cidInterface.Connect(ConfigurationManager.AppSettings["CameraIPAddresss"], Int32.Parse(ConfigurationManager.AppSettings["CameraIPPort"]));
                        //firmwareId = cidInterface.get();
                    });
                    task.Start();
                    await task;
                    ultraStatusBar1.Panels["CameraStatus"].Text = "Connecting to Camera....";
                   
                                       
                    if (!cameraConnected)// || firmwareId == 0)
                    {
                        log.Error("Firmware not running or camera not connected to host");
                        MessageBox.Show(
                            "Firmware not running or camera not connected to host",
                            "Firmware not found",
                             MessageBoxButtons.OK,
                             MessageBoxIcon.Information);
                        ultraStatusBar1.Panels["CameraStatus"].Text = "Camera Not Connected";
                        ultraStatusBar1.Panels["CameraStatus"].Appearance.BackColor = Color.Red;
                        ultraToolbarsManager1.Tools[101].SharedProps.AppearancesSmall.Appearance.Image = new Bitmap(Assembly.GetEntryAssembly().GetManifestResourceStream("KronosCameraTestApp.Resources.Camera_Off.bmp"));
                        return;
                    }
                    else
                    {
                       
                        if (instrumentDefaults.EnableOnConnect)
                            // Set the voltages automatically after each connection 
                            instrumentDefaults.ConfigStructForInstrumentDefaults();
                    }
                    TECCheckBox.Enabled = true;
                    ultraStatusBar1.Panels["CameraStatus"].Text = "CID821 Connected";//, FW Ver. " + firmwareId.ToString();
                    ultraStatusBar1.Panels["CameraStatus"].Appearance.BackColor = Color.LimeGreen;
                    ultraToolbarsManager1.Tools[101].SharedProps.AppearancesSmall.Appearance.Image = new Bitmap(Assembly.GetEntryAssembly().GetManifestResourceStream("KronosCameraTestApp.Resources.Camera_ON.bmp"));
                    //log.Info("Camera with Firmware ID" + firmwareId.ToString() + "connected.");
                    
                    //todo
                    //cidInterface.SetThermoElectricCoolerTemperature(-45);
                    //cidInterface.EnableThermoElectricCooler(); 
                    TECCheckBox_Click(null, null);
                    cidInterface.GetCameraInformation();
                    UpdateCameraDetailsOnScreen(cameraInformation);
                    
                    //textBoxHumiditySensorSN.Text = cameraInformation.HumiditySensorSerialNumber.ToString();
                }
                else if (cidInterface.IsConnected())
                {
                    cidInterface.Disconnect();
                    var task = new Task(delegate()
                    {
                        cidInterface.Disconnect();
                    });
                    task.Start();
                    await task;
                    ultraStatusBar1.Panels["CameraStatus"].Text = "Camera Disconnected";
                    ultraStatusBar1.Panels["CameraStatus"].Appearance.BackColor = Color.Red;
                    ultraToolbarsManager1.Tools[101].SharedProps.AppearancesSmall.Appearance.Image = new Bitmap(Assembly.GetEntryAssembly().GetManifestResourceStream("KronosCameraTestApp.Resources.Camera_Off.bmp"));
                }
            }
            catch (Exception ex)
            {
                log.Error("Exception in" + MethodBase.GetCurrentMethod(), ex);
            }
        }        
