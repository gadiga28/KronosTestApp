                meanVariancePresenter.SubarrayDataModel.TimeResolvedEnabled = ultraCheckEditorTimeResolved.Checked;
                meanVariancePresenter.SubarrayDataModel.AdaptiveEnabled = ultraCheckEditorAdaptive.Checked;
