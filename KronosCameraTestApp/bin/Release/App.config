    <!--Azure database-->
    <add name="KronosCamContext1" connectionString="server=tcp:tfs-scm5821x1.database.windows.net,1433; database = SCM5821AX1_Factory_Database;Persist Security Info=False; User Id=sysadmin; Password=P@ssw0rd;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30" providerName="System.Data.SqlClient" />
  </connectionStrings>
